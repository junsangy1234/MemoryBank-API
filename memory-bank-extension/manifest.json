{
  "manifest_version": 3,
  "name": "AI Memory Bank",
  "version": "1.0",
  "description": "ChatGPT와 Gemini에서 나의 개인 기억을 불러오고 저장합니다.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://aimemorybank.cloud/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Memory Bank 열기"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "827086239641-a6v5sbhmu9v7kq9pj487i548ljsvcino.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}